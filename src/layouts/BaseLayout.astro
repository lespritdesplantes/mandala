---
import type { ImageMetadata } from 'astro';
import { Font, getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';
import imageParDefaut from '../assets/photos/jardin-et-atelier/paysage/jardin.jpg';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Image de partage (Open Graph). Par défaut : une photo du jardin. */
  image?: ImageMetadata;
  /** Données structurées schema.org, injectées en JSON-LD. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Page à exclure des moteurs de recherche (ex. : 404) */
  noindex?: boolean;
}

const { title, description, image = imageParDefaut, jsonLd, noindex = false } = Astro.props;

const titreComplet = Astro.url.pathname === '/' ? SITE.nom : `${title} · ${SITE.nomCourt}`;
const canonique = new URL(Astro.url.pathname, Astro.site);
const imagePartage = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const urlImagePartage = new URL(imagePartage.src, Astro.site);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonique} />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#022b42" />

    <Font cssVariable="--font-titre" preload />
    <Font cssVariable="--font-texte" preload />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={SITE.nom} />
    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />
    <meta property="og:image" content={urlImagePartage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="lien-evitement" href="#contenu">Aller au contenu</a>
    <Header />
    <main id="contenu" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
