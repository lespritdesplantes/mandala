---
// Icône Instagram en SVG inline (aucune ressource chargée depuis Meta). Décorative : le texte du lien porte le sens.
interface Props {
  taille?: number;
}

const { taille = 22 } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  width={taille}
  height={taille}
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <rect x="3" y="3" width="18" height="18" rx="5"></rect>
  <circle cx="12" cy="12" r="4"></circle>
  <circle cx="17.5" cy="6.5" r="0.6" fill="currentColor"></circle>
</svg>
