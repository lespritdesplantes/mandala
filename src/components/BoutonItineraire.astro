---
// Bouton « Itinéraire » vers Google Maps, ouvert dans un nouvel onglet.
// `nom` complète le texte accessible : « Itinéraire vers La Tisanerie d’Oc, Rions ».
import { urlItineraire, type Adresse } from '../data/lieux';

interface Props {
  adresse: Adresse;
  nom: string;
}

const { adresse, nom } = Astro.props;
---

<a class="bouton itineraire" href={urlItineraire(adresse)} target="_blank" rel="noopener noreferrer">
  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
    <path
      d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21Z"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linejoin="round"></path>
    <circle cx="12" cy="9.5" r="2.5" fill="none" stroke="currentColor" stroke-width="2"></circle>
  </svg>
  Itinéraire<span class="visually-hidden"> vers {nom} (nouvel onglet)</span>
</a>

<style>
  .itineraire {
    padding-inline: 1.1em 1.3em;
  }

  .itineraire svg {
    flex-shrink: 0;
  }
</style>
