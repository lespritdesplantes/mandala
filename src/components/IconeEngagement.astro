---
// Icônes au trait fin des engagements (accueil). Purement décoratives : aria-hidden.
interface Props {
  nom: 'biologique' | 'ethique' | 'artisanal';
}
const { nom } = Astro.props;
---

<svg
  class="icone-engagement"
  viewBox="0 0 48 48"
  width="56"
  height="56"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    nom === 'biologique' && (
      <>
        {/* Pousse sortant d'une terre vivante, arrosée avec sobriété */}
        <path d="M24 39V21" />
        <path d="M24 28c-1.2-6.5-5.6-10-12.5-10 .6 6.6 5 10 12.5 10Z" />
        <path d="M24 23c.8-5.8 4.8-9.2 11.5-9.2-.5 5.9-4.4 9.2-11.5 9.2Z" />
        <path d="M17.5 24.5 21 26.5M30.5 17.8 27 20" />
        <path d="M9 39h30" />
        <path d="M13 43h7m5 0h10" />
        <path d="M35 5.5c-1.4 2-2.2 3.4-2.2 4.4a2.2 2.2 0 0 0 4.4 0c0-1-.8-2.4-2.2-4.4Z" />
      </>
    )
  }
  {
    nom === 'ethique' && (
      <>
        {/* Mains en coupe qui portent un cœur : soin, coopération, ancrage */}
        <path d="M24 30.5s-7.5-4.6-7.5-9.4c0-2.6 2-4.3 4.2-4.3 1.5 0 2.7.8 3.3 2 .6-1.2 1.8-2 3.3-2 2.2 0 4.2 1.7 4.2 4.3 0 4.8-7.5 9.4-7.5 9.4Z" />
        <path d="M5.5 25.5c1.8-.6 3.6.2 4.6 1.7l3.4 5.2c1.4 2.1 3.7 3.4 6.2 3.4H24" />
        <path d="M42.5 25.5c-1.8-.6-3.6.2-4.6 1.7l-3.4 5.2c-1.4 2.1-3.7 3.4-6.2 3.4H24" />
        <path d="M8 31.5c2.2 5.3 7.2 9 13 9.4M40 31.5c-2.2 5.3-7.2 9-13 9.4" />
        <path d="M24 35.8v5.2" />
      </>
    )
  }
  {
    nom === 'artisanal' && (
      <>
        {/* Mortier, pilon et brin de plante : la transformation à la main */}
        <path d="M8 25h32" />
        <path d="M10 25c0 8.3 6.3 14 14 14s14-5.7 14-14" />
        <path d="M19.5 38.2 18 43h12l-1.5-4.8" />
        <path d="m27.5 24 8.8-15.2a2.3 2.3 0 0 1 4 2.3L31.5 26.3" />
        <path d="M17 25c-.4-4.6 1.8-7.8 6-9-.1 4.5-2.3 7.6-6 9Z" />
        <path d="M14 25c-1.2-2.7-1-5 .6-7" />
      </>
    )
  }
</svg>

<style>
  .icone-engagement {
    display: block;
    width: 4rem;
    height: 4rem;
    margin-bottom: 0.75rem;
    color: var(--ocre);
  }
</style>
