---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import FilAriane from '../components/FilAriane.astro';
import IconeInstagram from '../components/IconeInstagram.astro';
import { SITE } from '../data/site';
import { localBusiness } from '../data/jsonld';
import photo from '../assets/photos/jardin-et-atelier/paysage/moi-ac-panier.jpg';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  url: `${SITE.url}/contact/`,
  mainEntity: localBusiness,
};
---

<BaseLayout
  title="Contact"
  description="Contacter Cécile Anselmino, productrice de plantes aromatiques et médicinales à Saint-Loubert (Gironde) : une question sur un produit, une commande, un marché."
  jsonLd={jsonLd}
>
  <div class="conteneur section contact">
    <div>
      <FilAriane elements={[{ label: 'Accueil', href: '/' }, { label: 'Contact', href: '/contact/' }]} />
      <h1>Contact</h1>
      <p class="chapo">
        Une question sur un produit, une disponibilité ou un marché ? Écrivez-moi, je vous réponds avec plaisir.
      </p>

      <p class="email">
        <a class="bouton" href={`mailto:${SITE.email}`}>
          <svg
            viewBox="0 0 24 24"
            width="22"
            height="22"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            <rect x="3" y="5" width="18" height="14" rx="2"></rect>
            <path d="m4 7 8 6 8-6"></path>
          </svg>
          {SITE.email}
        </a>
      </p>
      <p class="instagram">
        <a href={SITE.instagram.url} target="_blank" rel="noopener">
          <IconeInstagram />
          Instagram : {SITE.instagram.compte}<span class="visually-hidden"> (nouvel onglet)</span>
        </a>
      </p>

      <h2 class="titre-souligne">Mandala – L’esprit des plantes</h2>
      <address>
        {SITE.productrice}<br />
        {SITE.adresse.rue}<br />
        {SITE.adresse.codePostal} {SITE.adresse.commune}
      </address>
      <p class="note">
        Pour découvrir les produits, retrouvez-moi{' '}
        <a href="/ou-nous-trouver/">sur les marchés et en boutique</a>.
      </p>
    </div>

    <Image
      src={photo}
      alt="Cécile Anselmino au jardin, tenant un panier d’osier rempli de plantes fraîchement cueillies"
      widths={[480, 720, 960]}
      sizes="(min-width: 60rem) 30rem, 100vw"
    />
  </div>
</BaseLayout>

<style>
  .contact {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 60rem) {
    .contact {
      grid-template-columns: 1fr 30rem;
      gap: 4rem;
    }
  }

  .contact h1 {
    margin-top: 1.25rem;
  }

  .chapo {
    max-width: 38rem;
    font-size: 1.15em;
  }

  .email {
    margin: 1.75rem 0 1rem;
  }

  .instagram {
    margin: 0 0 2.5rem;
  }

  .instagram a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .instagram svg {
    flex-shrink: 0;
  }

  .email .bouton {
    font-size: 1.05rem;
    word-break: break-all;
  }

  .email svg {
    flex-shrink: 0;
  }

  .contact h2 {
    font-size: 2.2rem;
  }

  address {
    font-style: normal;
    margin-bottom: 1rem;
  }

  .note {
    color: var(--encre-douce);
  }

  .contact :global(img) {
    width: 100%;
    border-radius: var(--rayon);
    box-shadow: var(--ombre);
  }
</style>
