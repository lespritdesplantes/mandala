---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import FilAriane from '../components/FilAriane.astro';
import { GALERIE } from '../data/galerie';

// Version agrandie de chaque photo pour la visionneuse (et pour le lien sans JavaScript)
const photos = await Promise.all(
  GALERIE.map(async (p) => ({
    ...p,
    grande: await getImage({ src: p.src, width: Math.min(1600, p.src.width), format: 'webp', quality: 78 }),
  })),
);
---

<BaseLayout
  title="Jardin et atelier"
  description="Au fil des saisons, du jardin à l’atelier : cultures biologiques, cueillettes, séchage des plantes et fabrication artisanale en sud Gironde."
  image={GALERIE[0].src}
>
  <div class="conteneur section entete-page">
    <FilAriane
      elements={[{ label: 'Accueil', href: '/' }, { label: 'Jardin et atelier', href: '/jardin-et-atelier/' }]}
    />
    <h1>Jardin et atelier</h1>
    <p class="chapo">
      Du jardin à l’atelier, au fil des saisons : les cultures, les cueillettes, le séchage des plantes et la
      fabrication, en sud Gironde.
    </p>
  </div>

  <section class="section section--vert" aria-label="Galerie photos">
    <ul class="conteneur galerie" role="list">
      {
        photos.map((p, i) => (
          <li>
            <a
              class="cadre-zoom galerie__lien"
              href={p.grande.src}
              data-index={i}
              data-largeur={p.grande.attributes.width}
              data-hauteur={p.grande.attributes.height}
              aria-haspopup="dialog"
            >
              <Image
                src={p.src}
                alt={p.alt}
                widths={[320, 480, 720]}
                sizes="(min-width: 72rem) 17rem, (min-width: 48rem) 30vw, 50vw"
              />
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <dialog class="visionneuse" aria-label="Visionneuse de photos">
    <figure>
      <img class="visionneuse__image" src="" alt="" />
      <figcaption id="visionneuse-legende">
        <span class="visionneuse__texte"></span>
        <span class="visionneuse__compteur" aria-live="polite"></span>
      </figcaption>
    </figure>
    <button class="visionneuse__bouton visionneuse__fermer" type="button" aria-label="Fermer la visionneuse">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
        <path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
      </svg>
    </button>
    <button class="visionneuse__bouton visionneuse__precedente" type="button" aria-label="Photo précédente">
      <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
        <path d="m15 5-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </button>
    <button class="visionneuse__bouton visionneuse__suivante" type="button" aria-label="Photo suivante">
      <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
        <path d="m9 5 7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </button>
  </dialog>
</BaseLayout>

<script>
  const dialogue = document.querySelector<HTMLDialogElement>('.visionneuse');
  const liens = [...document.querySelectorAll<HTMLAnchorElement>('.galerie__lien')];

  if (dialogue && typeof dialogue.showModal === 'function') {
    const image = dialogue.querySelector<HTMLImageElement>('.visionneuse__image')!;
    const texte = dialogue.querySelector<HTMLElement>('.visionneuse__texte')!;
    const compteur = dialogue.querySelector<HTMLElement>('.visionneuse__compteur')!;
    let courant = 0;
    let declencheur: HTMLElement | null = null;

    const afficher = (index: number) => {
      courant = (index + liens.length) % liens.length;
      const lien = liens[courant];
      const vignette = lien.querySelector('img');
      image.src = lien.href;
      image.alt = vignette?.alt ?? '';
      image.width = Number(lien.dataset.largeur);
      image.height = Number(lien.dataset.hauteur);
      texte.textContent = vignette?.alt ?? '';
      compteur.textContent = `Photo ${courant + 1} sur ${liens.length}`;
    };

    liens.forEach((lien, i) => {
      lien.addEventListener('click', (e) => {
        // Laisse le comportement normal pour ouvrir dans un nouvel onglet
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
        e.preventDefault();
        declencheur = lien;
        afficher(i);
        dialogue.showModal();
        dialogue.querySelector<HTMLButtonElement>('.visionneuse__fermer')!.focus();
      });
    });

    dialogue.querySelector('.visionneuse__fermer')!.addEventListener('click', () => dialogue.close());
    dialogue.querySelector('.visionneuse__precedente')!.addEventListener('click', () => afficher(courant - 1));
    dialogue.querySelector('.visionneuse__suivante')!.addEventListener('click', () => afficher(courant + 1));

    dialogue.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') afficher(courant - 1);
      if (e.key === 'ArrowRight') afficher(courant + 1);
    });

    // Clic sur le fond assombri : fermeture (Échap est géré nativement par <dialog>)
    dialogue.addEventListener('click', (e) => {
      if (e.target === dialogue) dialogue.close();
    });

    // Rend le focus à la vignette d'origine
    dialogue.addEventListener('close', () => {
      declencheur?.focus();
      image.removeAttribute('src');
    });
  }
</script>

<style>
  .entete-page {
    padding-bottom: 2rem;
  }

  .entete-page h1 {
    margin-top: 1.25rem;
  }

  .chapo {
    max-width: 42rem;
    font-size: 1.15em;
  }

  .galerie {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
    margin-block: 0;
    list-style: none;
  }

  @media (min-width: 48rem) {
    .galerie {
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
    }
  }

  @media (min-width: 72rem) {
    .galerie {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .galerie__lien {
    aspect-ratio: 4 / 5;
    cursor: zoom-in;
  }

  /* Visionneuse */
  .visionneuse {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 3.5rem 0.75rem 1rem;
    border: 0;
    background: rgb(2 43 66 / 0.96);
    color: var(--blanc-casse);
  }

  .visionneuse::backdrop {
    background: rgb(2 43 66 / 0.8);
  }

  .visionneuse figure {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    height: 100%;
    margin: 0;
  }

  .visionneuse__image {
    max-width: min(100%, 72rem);
    max-height: calc(100% - 4rem);
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 0.5rem;
  }

  .visionneuse figcaption {
    max-width: 50rem;
    text-align: center;
  }

  .visionneuse__compteur {
    display: block;
    margin-top: 0.2rem;
    color: var(--ocre);
    font-size: 0.85rem;
    font-weight: 700;
  }

  .visionneuse__bouton {
    position: absolute;
    display: grid;
    place-items: center;
    width: 2.9rem;
    height: 2.9rem;
    border: 2px solid rgb(251 250 246 / 0.6);
    border-radius: 50%;
    background: rgb(2 43 66 / 0.7);
    color: var(--blanc-casse);
    cursor: pointer;
  }

  .visionneuse__bouton:hover {
    border-color: var(--ocre);
    color: var(--ocre);
  }

  .visionneuse__fermer {
    top: 0.5rem;
    right: 0.75rem;
  }

  .visionneuse__precedente,
  .visionneuse__suivante {
    top: 50%;
    transform: translateY(-50%);
  }

  .visionneuse__precedente {
    left: 0.75rem;
  }

  .visionneuse__suivante {
    right: 0.75rem;
  }
</style>
